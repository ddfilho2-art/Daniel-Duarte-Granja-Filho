# GEMINI_API_KEY: Required for server-side AI processing only.
# Never expose this key through a VITE_* variable or browser bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase public client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server/automation secrets — never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
